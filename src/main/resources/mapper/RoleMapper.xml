<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.rag.mapper.RoleMapper">
    <select id="selectByName" resultType="com.example.rag.domain.Role">
        select * from roles
        where name = #{name}
        limit 1
    </select>
</mapper>
