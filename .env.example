# Backend runtime
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/ragkb
DB_USERNAME=rag
DB_PASSWORD=rag

# JWT
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_MINUTES=1440

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rag-documents

# OpenAI-compatible model provider
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_CHAT_MODEL=qwen3.7-plus
OPENAI_EMBEDDING_MODEL=text-embedding-v4
OPENAI_EMBEDDING_DIMENSIONS=1536

# Ingestion worker
INGESTION_WORKER_ENABLED=true
INGESTION_FIXED_DELAY_MS=5000
INGESTION_MAX_ATTEMPTS=3
INGESTION_BATCH_SIZE=3

# Retrieval
RETRIEVAL_VECTOR_WEIGHT=0.65
RETRIEVAL_KEYWORD_WEIGHT=0.35
